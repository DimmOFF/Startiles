{
  "manifest_version": 3,
  "name": "Modern Speed Dial",
  "version": "1.0.18",
  "description": "Vivaldi-style Speed Dial for Chromium browsers: groups, folders, drag & drop, bookmarks storage.",
  "permissions": ["bookmarks", "storage", "unlimitedStorage", "favicon", "history", "tabs"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Open Modern Speed Dial in a new tab" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "icons": { "16": "icons/icon16-alt.png", "32": "icons/icon32-alt.png", "48": "icons/icon48-alt.png", "128": "icons/icon128-alt.png" }
}
